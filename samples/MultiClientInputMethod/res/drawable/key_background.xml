<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded key "card": checked (sticky shift on) > pressed > normal. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="3dp" android:insetTop="3dp"
               android:insetRight="3dp" android:insetBottom="3dp">
            <layer-list>
                <item>
                    <shape android:shape="rectangle">
                        <solid android:color="@color/key_shadow"/>
                        <corners android:radius="8dp"/>
                    </shape>
                </item>
                <item android:bottom="1.5dp">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/key_checked"/>
                        <corners android:radius="8dp"/>
                    </shape>
                </item>
            </layer-list>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetLeft="3dp" android:insetTop="3dp"
               android:insetRight="3dp" android:insetBottom="3dp">
            <layer-list>
                <item>
                    <shape android:shape="rectangle">
                        <solid android:color="@color/key_shadow"/>
                        <corners android:radius="8dp"/>
                    </shape>
                </item>
                <item android:bottom="0.5dp">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/key_pressed"/>
                        <corners android:radius="8dp"/>
                    </shape>
                </item>
            </layer-list>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="3dp" android:insetTop="3dp"
               android:insetRight="3dp" android:insetBottom="3dp">
            <layer-list>
                <item>
                    <shape android:shape="rectangle">
                        <solid android:color="@color/key_shadow"/>
                        <corners android:radius="8dp"/>
                    </shape>
                </item>
                <item android:bottom="1.5dp">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/key_background"/>
                        <corners android:radius="8dp"/>
                    </shape>
                </item>
            </layer-list>
        </inset>
    </item>
</selector>
